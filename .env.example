# 複製成 .env 後填入；.env 已被 .gitignore 排除，不會上傳到 GitHub
# LINE Developers → 你的 channel → Messaging API 分頁
LINE_BOT_TOKEN=
# LINE Developers → 你的 channel → Basic settings → Channel secret
LINE_BOT_SECRET=
# 每個追蹤都會額外通知的 LINE user ID，用逗號分隔（可留空）
DEV_USER_IDS=
# （選填）紀錄檔與追蹤狀態的資料夾，預設 E:\line-bot
# BOT_HOME=E:\line-bot
